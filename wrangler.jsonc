{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoking-tools",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "limits": {
    "cpu_ms": 1000
  }
}
